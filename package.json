{
  "name": "wellovue",
  "version": "0.1.0",
  "private": true,
  "description": "Wellovue \u2014 turns everyday diabetes data into personal, testable metabolic evidence.",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "build": "npm run build --workspace @wellovue/types && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.mjs status",
    "db:verify-tls": "node --env-file-if-exists=.env scripts/verify-db-tls.mjs",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d redis",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml --env-file .env logs -f",
    "docker:build": "docker compose -f infra/docker/docker-compose.yml --env-file .env build",
    "test:docker": "bash scripts/test-docker.sh",
    "test:docker:down": "docker compose -f infra/docker/docker-compose.test.yml down -v --remove-orphans",
    "test:stack:up": "docker compose -f infra/docker/docker-compose.test.yml up -d --build postgres minio minio-init migrate metabolic-engine-test",
    "test:integration": "npm run test:integration --workspace backend",
    "test:docker:keep": "KEEP_UP=1 bash scripts/test-docker.sh"
  },
  "devDependencies": {
    "pg": "^8.13.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "lodash": "^4.18.1",
    "postcss": "^8.5.23",
    "vite": "^6.4.3"
  }
}
