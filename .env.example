# ---------------------------------------------------------------------------
# Diabetes Platform — environment template
# Copy to `.env` and fill in the secrets. `.env` is gitignored.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL 17 + TimescaleDB + pgvector (VM 10.10.5.185) ---------------
DATABASE_URL=postgresql://diabetes_app:REPLACE_ME@10.10.5.185:5432/diabetes?sslmode=require
# The VM currently uses PostgreSQL's default self-signed certificate, so the
# connection is encrypted but the certificate is NOT verified. libpq clients
# (psql, psycopg) express that as `sslmode=require` in the URL above; the
# node-postgres driver needs the flag below to match.
#
# Before production: issue a CA-signed server certificate, set this to `true`,
# and change the URL to `sslmode=verify-full`.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Redis (local docker, see infra/docker/docker-compose.yml) -------------
# Where rate limit counts live. Set: one budget shared by every replica.
# Unset: counted in each backend process, which is correct for one container
# and wrong for more than one.
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO, VM 10.10.5.240) ------------------
S3_ENDPOINT=http://10.10.5.240:9000
S3_REGION=limk-dub
S3_BUCKET=medicaldata
S3_ACCESS_KEY_ID=diabetes-platform
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=true
# All platform objects live under this prefix — the bucket is shared.
S3_PREFIX=diabetes-platform/

# --- Auth ------------------------------------------------------------------
# Interim local JWT auth. Swap for OIDC before production (see docs).
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Security ---------------------------------------------------------------
# Believe X-Forwarded-For. Leave false until a reverse proxy in front of the
# backend overwrites it: when nothing trustworthy sets the header, anyone can,
# and the rate limiter would key on a value the caller chose.
TRUST_PROXY=false

# Refuse to boot when the database connection is encrypted but unverified.
# Flip to true once the host has a DNS name, a CA-signed certificate is
# installed, and the URL says sslmode=verify-full. Setting it while
# DATABASE_URL still points at a bare IP address is refused with the reason,
# because no certificate can satisfy verify-full against an IP literal.
# See infra/README.md.
REQUIRE_VERIFIED_DB_TLS=false

# Refuse to boot when rate limits are counted per process rather than shared.
# Flip to true at the moment a second backend replica appears: without REDIS_URL
# each replica has its own budget, so an attacker gets the limit once per
# replica. See infra/README.md.
REQUIRE_SHARED_RATE_LIMIT=false

# Warn above this many ms of actual statement execution (acquisition is timed
# and reported separately). Raise it on a machine reaching the database over a
# VPN: ~55ms per query there is round trip, not work, and it disappears once
# the backend runs beside the database.
SLOW_QUERY_WARN_MS=250
SLOW_ACQUIRE_WARN_MS=1000

# Rate limits. Windows are in seconds.
# Global backstop, applied to every route.
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_GLOBAL_TTL_S=60
# Sign-in and registration, keyed on address AND target account.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_S=900
# Session refresh: several tabs legitimately refresh at once.
THROTTLE_REFRESH_LIMIT=60
THROTTLE_REFRESH_TTL_S=900
# Unauthenticated writes: waitlist, contact.
THROTTLE_WRITE_LIMIT=5
THROTTLE_WRITE_TTL_S=3600

# --- Services --------------------------------------------------------------
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
METABOLIC_ENGINE_URL=http://localhost:8000
# Shared secret for backend -> metabolic-engine service calls.
METABOLIC_ENGINE_TOKEN=REPLACE_ME

# --- Frontend (NEXT_PUBLIC_* is exposed to the browser) --------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
