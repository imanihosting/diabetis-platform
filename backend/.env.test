# Points the local integration suite at the Docker test stack
# (npm run test:stack:up). Contains no real credentials.
DATABASE_URL=postgresql://diabetes_test:diabetes_test@localhost:55432/diabetes_test?sslmode=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=false
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=medicaldata
S3_ACCESS_KEY_ID=testaccess
S3_SECRET_ACCESS_KEY=testsecret123
S3_FORCE_PATH_STYLE=true
S3_PREFIX=diabetes-platform/
JWT_SECRET=test-secret-that-is-long-enough-for-validation
METABOLIC_ENGINE_URL=http://localhost:58000
NODE_ENV=test
