# Points the local integration suite at the Docker test stack
# (npm run test:stack:up). Contains no real credentials.
DATABASE_URL=postgresql://wellovue_test:wellovue_test@localhost:55432/wellovue_test?sslmode=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=false
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=medicaldata
S3_ACCESS_KEY_ID=testaccess
S3_SECRET_ACCESS_KEY=testsecret123
S3_FORCE_PATH_STYLE=true
S3_PREFIX=diabetes-platform/
JWT_SECRET=test-secret-that-is-long-enough-for-validation
METABOLIC_ENGINE_URL=http://localhost:58000
NODE_ENV=test

# Rate limits, raised so the suite does not throttle itself. The dedicated
# throttle spec sets its own tiny limits and asserts the 429.
THROTTLE_GLOBAL_LIMIT=100000
THROTTLE_AUTH_LIMIT=10000
THROTTLE_REFRESH_LIMIT=10000
THROTTLE_WRITE_LIMIT=10000
